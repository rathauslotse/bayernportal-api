{
    "name": "rathauslotse/bayernportal-api",
    "description": "Laravel client for the BayernPortal REST API v3 (agencies, authorities, contacts, services, forms, online procedures and life situations of Bavarian public administration).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bayernportal",
        "bayern",
        "bavaria",
        "e-government",
        "public-administration",
        "api-client"
    ],
    "homepage": "https://github.com/rathauslotse/bayernportal-api",
    "authors": [
        {
            "name": "Michael Firlus",
            "email": "m.firlus@civireach.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Rathauslotse\\BayernPortal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rathauslotse\\BayernPortal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --exclude-group=integration",
        "test:integration": "pest --group=integration",
        "test:coverage": "pest --exclude-group=integration --coverage --min=90",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rathauslotse\\BayernPortal\\BayernPortalServiceProvider"
            ],
            "aliases": {
                "BayernPortal": "Rathauslotse\\BayernPortal\\Facades\\BayernPortal"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
